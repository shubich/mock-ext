{
  "manifest_version": 3,
  "name": "MockWeave",
  "version": "0.2.0",
  "description": "Intercept HTTP with DevTools Protocol: fake responses or override outgoing requests (method, URL, headers, body).",
  "devtools_page": "devtools.html",
  "action": {
    "default_title": "MockWeave",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": ["storage", "debugger", "tabs"],
  "host_permissions": ["<all_urls>"]
}
